# Runtime
PORT=3000
NODE_ENV=development

# Official public FPL API. Override only for a compatible upstream or local fixture server.
FPL_API_BASE=https://fantasy.premierleague.com/api
FPL_REQUEST_TIMEOUT_MS=9000

# Cache lifetimes in seconds.
FPL_CACHE_STATIC_SECONDS=600
FPL_CACHE_LIVE_SECONDS=45
FPL_CACHE_PROFILE_SECONDS=180
FPL_CACHE_ODDS_SECONDS=300

# Live Premier League Betting Market Odds (Implied Goals, Clean Sheet % & Win %).
# Keyless live feeds (Football-Data.co.uk Pinnacle/Market Avg CSV + ESPN EPL Scoreboard) run automatically.
# Optional: set a free API key from https://the-odds-api.com for real-time sharp UK/EU bookmaker lines:
ODDS_API_KEY=
# Optional second account: used only after the first reports exhausted credits.
ODDS_API_KEY_BACKUP=

# Path to the offline snapshot committed for resilient startup.
VORTEX_SNAPSHOT_PATH=public/data/fpl-snapshot.json

# Published deployment used by `npm run data:mirror` (and the mirror workflow).
# The mirrored snapshot carries upstream odds enrichment and is served as healthy cache data
# for VORTEX_MIRROR_FRESH_MINUTES minutes before being reported as an offline snapshot.
VORTEX_UPSTREAM_BASE=https://fplvortex.onrender.com
VORTEX_MIRROR_FRESH_MINUTES=180
