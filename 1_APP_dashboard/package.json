{
  "name": "fpl-vortex-premium",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:planning": "node --test scripts/*.test.cjs",
    "check:env": "node scripts/check-env.cjs",
    "db:migrate": "node scripts/migrate-db.cjs --apply",
    "db:migrate:dry-run": "node scripts/migrate-db.cjs --dry-run",
    "db:migrate:verify": "node scripts/migrate-db.cjs --verify",
    "db:baseline:adopt": "node scripts/migrate-db.cjs --adopt-baseline",
    "worker": "node --experimental-transform-types --experimental-loader ./scripts/worker-loader.mjs scripts/background-worker.mjs",
    "worker:once": "node --experimental-transform-types --experimental-loader ./scripts/worker-loader.mjs scripts/background-worker.mjs --once",
    "test:smoke": "node scripts/quality-smoke.cjs",
    "test:reports": "python scripts/reporting/render_report.py --json scripts/reporting/sample-report.json --out /tmp/vortex-report-smoke",
    "check:release": "node scripts/release-gates.cjs"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
