# REQUIRED: application database and migrations. Never commit real credentials.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/fpl_vortex

# REQUIRED for scheduled refresh on Vercel (minimum 16 unpredictable characters).
CRON_SECRET=

# Optional AI explanations (disabled unless key and supported model are configured).
FPL_AI_ENABLED=false
OPENAI_API_KEY=
FPL_COPILOT_MODEL=

# Public origin of the production domain, HTTPS in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional, advanced features.
FPL_PYTHON=python3
ANTHROPIC_API_KEY=
PRESS_FEEDS=
YOUTUBE_CHANNEL_ID=
FOTMOB_FALLBACK=off

# REQUIRED before enabling user registration and password recovery.
RESEND_API_KEY=
AUTH_FROM_EMAIL=
