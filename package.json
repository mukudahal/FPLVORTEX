{
  "name": "fplvortex",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Original FPL analytics, licensed-data contracts and reproducible historical evaluation",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "npm run test",
    "import:data": "npm run build && node scripts/import-snapshot.mjs",
    "validate:data": "npm run build && node scripts/import-snapshot.mjs --validate-only",
    "db:migrate": "node scripts/migrate.mjs",
    "history:validate": "node scripts/import-history.mjs --validate-only",
    "history:import": "node scripts/import-history.mjs --write",
    "league:sync": "node scripts/sync-public-league.mjs",
    "league:check": "node scripts/sync-public-league.mjs --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}