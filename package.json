{
  "name": "fpl-vortex",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "description": "An automated Fantasy Premier League intelligence and squad optimization platform.",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsx scripts/export-static-data.ts",
    "start": "tsx server/index.ts",
    "preview": "npm run build && cross-env NODE_ENV=production npm start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:watch": "node --import tsx --test --watch tests/*.test.ts",
    "data:refresh": "tsx scripts/refresh-snapshot.ts",
    "data:mirror": "tsx scripts/mirror-upstream.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "data:archive-matches": "tsx scripts/archive-fpl-matches.ts",
    "data:archive-forecasts": "node --import tsx scripts/archive-forecasts.ts",
    "data:settle-forecasts": "node --import tsx scripts/settle-forecasts.ts"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "cross-env": "^10.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
