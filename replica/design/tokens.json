{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "metadata": {
    "name": "Original light FPL intelligence theme",
    "version": "0.1.0",
    "principles": [
      "white background",
      "green and blue headings",
      "black body",
      "filled FDR indicators",
      "real licensed player headshots",
      "no jersey illustrations",
      "no Patreon interface"
    ]
  },
  "colors": {
    "canvas": "#FFFFFF",
    "surface": "#FFFFFF",
    "surfaceMuted": "#F6F9FB",
    "border": "#DFE8EC",
    "text": "#111827",
    "textMuted": "#475467",
    "headingGreen": "#087F5B",
    "headingBlue": "#0868C6",
    "link": "#0868C6",
    "success": "#067647",
    "warning": "#A15C07",
    "danger": "#B42318",
    "accentLight": "#E9F7F1"
  },
  "fdr": {
    "1": {
      "background": "#BDEFD8",
      "text": "#102A21",
      "label": "Very favorable"
    },
    "2": {
      "background": "#D9F2E8",
      "text": "#102A21",
      "label": "Favorable"
    },
    "3": {
      "background": "#FFF0B3",
      "text": "#3B2D10",
      "label": "Balanced"
    },
    "4": {
      "background": "#FFD2C9",
      "text": "#47211B",
      "label": "Difficult"
    },
    "5": {
      "background": "#FFADA7",
      "text": "#4B1111",
      "label": "Very difficult"
    }
  },
  "typography": {
    "fontFamily": "Inter, system-ui, sans-serif",
    "h1": "clamp(2.25rem, 4vw, 4rem)",
    "h2": "clamp(1.5rem, 2.5vw, 2.5rem)",
    "body": "1rem",
    "data": "0.875rem"
  },
  "radii": {
    "card": "16px",
    "control": "10px",
    "pill": "999px"
  },
  "shadows": {
    "card": "0 6px 24px rgb(16 24 40 / 0.06)",
    "active": "0 10px 30px rgb(8 104 198 / 0.12)"
  },
  "spacing": {
    "base": "4px",
    "containerMax": "1440px"
  },
  "media": {
    "type": "licensed headshot",
    "fallback": "initials avatar",
    "show_kit_illustrations": false
  }
}